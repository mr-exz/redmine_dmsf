<% path = parent_path ? "#{parent_path} / #{node[:folder].title}" : node[:folder].title %>
<% expandable = node[:children].any? || attach %>
<li class="<%= 'dmsf-folder-collapsed' if expandable %>">
  <div class="dmsf-folder-row">
    <span class="dmsf-folder-toggle <%= 'dmsf-folder-leaf' unless expandable %>"></span>
    <a href="#" class="dmsf-folder-pick" data-value="<%= node[:folder].id %>" data-path="<%= path %>">
      <%= sprite_icon('folder', node[:folder].title) %>
    </a>
  </div>
  <% if expandable %>
    <ul>
      <%= render partial: 'dmsf/folder_picker_node', collection: node[:children], as: :node,
                 locals: { attach: attach, parent_path: path } %>
      <% if attach %>
        <li class="dmsf-attach-files" data-folder-id="<%= node[:folder].id %>" data-pending="1"></li>
      <% end %>
    </ul>
  <% end %>
</li>
